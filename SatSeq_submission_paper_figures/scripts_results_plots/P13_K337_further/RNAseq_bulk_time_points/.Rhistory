library(dplyr)
library(ggplot2)
library(ggrepel)
library(cowplot)
# 1. Group and average X1-X3 per pos_num only
agg_df <- hotspot_df %>%
group_by(pos_num) %>%
summarise(
X1 = mean(X1, na.rm = TRUE),
X2 = mean(X2, na.rm = TRUE),
X3 = mean(X3, na.rm = TRUE),
pos_label = first(pos_raw),
.groups = "drop"
)
# 2. Merge with fitness_data matching position to pos_num
merged_df <- agg_df %>%
left_join(fitness_data, by = c("pos_num" = "position"))
# 3. Calculate threshold and identify points with fitness > 1 SD of fitness
# Uses mean + 1 standard deviation of the 'additive' column
fitness_mean <- mean(merged_df$additive, na.rm = TRUE)
fitness_sd   <- sd(merged_df$additive, na.rm = TRUE)
sd_threshold <- fitness_mean + fitness_sd
high_fitness_points <- merged_df %>%
filter(additive > sd_threshold)
# 4. Make the dotplot
