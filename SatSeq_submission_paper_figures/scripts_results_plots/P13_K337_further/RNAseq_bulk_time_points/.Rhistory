summarise(
X1 = mean(X1, na.rm = TRUE),
X2 = mean(X2, na.rm = TRUE),
X3 = mean(X3, na.rm = TRUE),
pos_label = first(pos_raw),
.groups = "drop"
)
# 2. Merge with fitness_data matching position to pos_num
merged_df <- agg_df %>%
left_join(fitness_data, by = c("pos_num" = "position"))
# 3. Identify the highest 10 in additive
top_10 <- merged_df %>%
slice_max(additive, n = 10, with_ties = FALSE)
# 4. Make the dotplot
ggplot(merged_df, aes(x = X2, y = X3, color = additive, size = additive)) +
geom_point(alpha = 0.9) +
scale_color_gradientn(
colors = rev(RColorBrewer::brewer.pal(11, "RdBu")),
limits = c(-0.1, 0.1),
oob = scales::squish,
name = "Additive"
) +
scale_size_continuous(range = c(1, 5), name = "Additive") +
geom_text_repel(
data = top_10,
aes(label = pos_label),
size = 3,
box.padding = 0.5,
max.overlaps = Inf
) +
labs(
title = "metastatic fitness",
x = "IFN Module score",
y = "NFkB Module score"
) +
theme_minimal()
