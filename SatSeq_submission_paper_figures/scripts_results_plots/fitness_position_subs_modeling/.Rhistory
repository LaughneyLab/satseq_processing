View(plot_df)
plot_df <- hotspot_df %>%
left_join(select(mets_bonds, position, monomer_fraction, dimer_fraction, mets_add, bond_group), by = c("pos_num" = "position")) %>%
mutate(
group = case_when(
pos_raw == "REF" ~ "REF",
pos_raw == "STOP" ~ "STOP",
!is.na(bond_group) ~ bond_group,
TRUE ~ "Other"
)
) %>%
filter(group %in% c("REF", "STOP", "mets_hi_monomer",
"mets_hi_dimer", "mets_lo")) %>%
mutate(group = factor(group, levels = c("REF", "STOP", "mets_hi_monomer",
"mets_hi_dimer", "mets_lo"))) %>%
pivot_longer(cols = starts_with("X"), names_to = "module", values_to = "score") %>%
mutate(
# Extract the number from 'X1', 'X2', etc.
module_num = as.numeric(str_extract(module, "\\d+")),
# Create the new clean name
module_clean = paste0("Module ", module_num),
# Reorder the factor levels based on the numeric order (1 to 4)
module_clean = factor(module_clean, levels = paste0("Module ", 1:4))
)
View(plot_df)
