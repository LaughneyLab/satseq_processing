# --- 8. Generate and Display the Bar Graph ---
p_final <- ggplot(df_plot, aes(x = Module, y = -log10(P_val), fill = Term)) +
# Create side-by-side (dodged) bar chart
geom_bar(stat = "identity", position = "dodge", color = "black", linewidth = 0.5) +
# Apply the cleaned up labels for the legend
scale_fill_discrete(labels = setNames(df_plot$Term_Clean, df_plot$Term)) +
theme_minimal() +
labs(
x = "Hotspot Module",
y = expression(-log[10](Adj.~P)),
fill = "Hallmark Pathway"
) +
theme(
axis.text.x = element_text(size = 11, face = "bold"),
axis.text.y = element_text(size = 10),
panel.border = element_rect(colour = "black", fill = NA, linewidth = 0.8),
panel.grid.major = element_line(colour = "gray95"),
axis.title.x = element_text(size = 12, face = "bold", margin = margin(t = 10)),
axis.title.y = element_text(size = 12, face = "bold", margin = margin(r = 10)),
legend.title = element_text(size = 11),
legend.text = element_text(size = 10),
legend.position = "right"
)
p_final
# --- 8. Generate and Display the Horizontal Bar Graph ---
p_final <- ggplot(df_plot, aes(x = -log10(P_val), y = Term, fill = Module)) +
# Create side-by-side comparison grouped by module
geom_col(position = position_dodge2(preserve = "single"), color = "black", linewidth = 0.3) +
# Apply the cleaned up labels directly to the y-axis
scale_y_discrete(labels = setNames(df_plot$Term_Clean, df_plot$Term)) +
# Clean, high-contrast palette for modules
scale_fill_brewer(palette = "Set2") +
theme_minimal() +
labs(
x = expression(-log[10](Adj.~P)),
y = "Hallmark Pathway",
fill = "Hotspot Module"
) +
theme(
axis.text.x = element_text(size = 10),
axis.text.y = element_text(size = 11, face = "bold"),
panel.border = element_rect(colour = "black", fill = NA, linewidth = 0.8),
panel.grid.major.x = element_line(colour = "gray95"),
panel.grid.minor.x = element_line(colour = "gray98"),
panel.grid.major.y = element_blank(), # Remove horizontal lines to clean up text rows
axis.title.x = element_text(size = 12, face = "bold", margin = margin(t = 10)),
axis.title.y = element_text(size = 12, face = "bold", margin = margin(r = 10)),
legend.title = element_text(size = 11),
legend.text = element_text(size = 10),
legend.position = "top"
)
p_final
# --- 8. Generate and Display the Faceted Bar Graph ---
p_final <- ggplot(df_plot, aes(x = -log10(P_val), y = reorder(Term, -log10(P_val)))) +
# Create solid black bars with thin white borders for clean separation
geom_col(fill = "black", color = "white", linewidth = 0.2, width = 0.8) +
# Apply the cleaned up labels directly to the y-axis
scale_y_discrete(labels = setNames(df_plot$Term_Clean, df_plot$Term)) +
# Separate into individual panels per module with independent y-axes
facet_wrap(~Module, scales = "free_y", ncol = 2) +
theme_minimal() +
labs(
x = expression(-log(Adj.~P)),
y = "Hallmark Pathway"
) +
theme(
axis.text.x = element_text(size = 10),
axis.text.y = element_text(size = 10),
# Style the module facet banner labels
strip.text = element_text(size = 11, face = "bold"),
strip.background = element_rect(fill = "gray95", colour = "black", linewidth = 0.5),
panel.border = element_rect(colour = "black", fill = NA, linewidth = 0.8),
panel.grid.major.x = element_line(colour = "gray90"),
panel.grid.minor.x = element_line(colour = "gray95"),
panel.grid.major.y = element_blank(),
axis.title.x = element_text(size = 12, face = "bold", margin = margin(t = 10)),
axis.title.y = element_text(size = 12, face = "bold", margin = margin(r = 10))
)
p_final
# --- 8. Generate and Display the Single-Row Faceted Bar Graph ---
p_final <- ggplot(df_plot, aes(x = -log10(P_val), y = Term)) +
# Create solid black bars with uniform heights
geom_col(fill = "black", color = "white", linewidth = 0.2, width = 0.8) +
# Apply the cleaned up labels directly to the shared y-axis
scale_y_discrete(labels = setNames(df_plot$Term_Clean, df_plot$Term)) +
# Force layout into a single row with a globally shared y-axis
facet_wrap(~Module, nrow = 1, scales = "fixed") +
theme_minimal() +
labs(
x = expression(-log(Adj.~P)),
y = "Hallmark Pathway"
) +
theme(
axis.text.x = element_text(size = 10),
axis.text.y = element_text(size = 10),
# Style the module facet banner labels
strip.text = element_text(size = 11, face = "bold"),
strip.background = element_rect(fill = "gray95", colour = "black", linewidth = 0.5),
panel.border = element_rect(colour = "black", fill = NA, linewidth = 0.8),
panel.grid.major.x = element_line(colour = "gray90"),
panel.grid.minor.x = element_line(colour = "gray95"),
panel.grid.major.y = element_blank(),
axis.title.x = element_text(size = 12, face = "bold", margin = margin(t = 10)),
axis.title.y = element_text(size = 12, face = "bold", margin = margin(r = 10))
)
p_final
View(df_plot)
