# Load required libraries
library(dplyr)
library(tidyr)
library(ggplot2)
library(ggpubr)
library(ggExtra)
# 1. Calculate average observed fitness per variant and cell_line
fitness_summary <- fitness_all %>%
group_by(variant, cell_line) %>%
summarize(avg_fitness = mean(observed_fitness, na.rm = TRUE), .groups = 'drop')
# 2. Reshape the data so 4T1 and EO771 are in their own columns
fitness_wide <- fitness_summary %>%
pivot_wider(names_from = cell_line, values_from = avg_fitness)
# 3. Create the scatter plot with a linear fit (lm)
p <- ggplot(fitness_wide, aes(x = `4T1`, y = EO771)) +
geom_point(alpha = 0.5, color = "darkblue") +
geom_smooth(method = "lm", color = "red", se = TRUE) +
stat_cor(method = "pearson", label.x.npc = "left", label.y.npc = "top") +
theme_minimal() +
labs(
title = "Fitness Correlation: 4T1 vs EO771",
x = "4T1 Average Fitness",
y = "EO771 Average Fitness"
)
# 4. Add marginal density plots
p_final <- ggMarginal(p, type = "density", fill = "gray", color = "darkblue", alpha = 0.3)
# Print the final plot
print(p_final)
