library(dplyr)
library(ggplot2)
library(ggpubr)
# 1. Generate full list of residues (1:378) and classify LOF status
all_residues <- tibble(position = 1:378) %>%
mutate(lof_status = if_else(position %in% lof_data$residue, "LOF", "Non-LOF"))
# 2. Merge with bonds data and ensure all bond types exist per position
plot_data <- all_residues %>%
left_join(bonds_summary, by = "position") %>%
mutate(
type = as.character(type),
total_bonds = coalesce(total_bonds, 0L)
)
# 3. Create the violin + jitter plot with statistical comparisons
ggplot(plot_data, aes(x = lof_status, y = total_bonds, fill = lof_status)) +
geom_violin(alpha = 0.5, trim = FALSE, outlier.shape = NA) +
geom_jitter(width = 0.2, alpha = 0.4, size = 1) +
facet_wrap(~type, scales = "free_y") +
stat_compare_means(
comparisons = list(c("LOF", "Non-LOF")),
method = "wilcox.test",
method.args = list(alternative = "two.sided"),
label = "p.signif"
) +
labs(
title = "Bond Distribution by LOF Status",
x = "Mutation Status",
y = "Number of Bonds"
) +
theme_minimal() +
theme(legend.position = "none")
library(dplyr)
library(tidyr)
library(ggplot2)
library(ggpubr)
# 1. Pivot bonds data wide to calculate total bonds per residue
bonds_wide <- bonds_summary %>%
mutate(type = as.character(type)) %>%
pivot_wider(names_from = type, values_from = total_bonds, values_fill = 0L) %>%
mutate(
grand_total = Monomer + Dimer + Tetramer,
# Calculate fractions (default to 0 if grand_total is 0 to avoid NaN)
Monomer_frac = if_else(grand_total > 0, Monomer / grand_total, 0),
Dimer_frac   = if_else(grand_total > 0, Dimer / grand_total, 0),
Tetramer_frac = if_else(grand_total > 0, Tetramer / grand_total, 0)
) %>%
select(position, ends_with("_frac"))
# 2. Pivot back to long format for ggplot faceting
bonds_fraction_long <- bonds_wide %>%
pivot_longer(
cols = ends_with("_frac"),
names_to = "bond_type",
names_pattern = "(.*)_frac",
values_to = "fraction"
)
# 3. Generate full residue map (1:378) and merge fractions
plot_fraction_data <- tibble(position = 1:378) %>%
mutate(lof_status = if_else(position %in% lof_data$residue, "LOF", "Non-LOF")) %>%
left_join(bonds_fraction_long, by = "position") %>%
# Fill positions that had no entries in bonds_summary with 0 fraction
mutate(
bond_type = tibble::coalesce(bond_type, "Monomer"),
fraction = tibble::coalesce(fraction, 0)
)
library(dplyr)
library(tidyr)
library(ggplot2)
library(ggpubr)
# 1. Pivot bonds data wide to calculate total bonds per residue
bonds_wide <- bonds_summary %>%
mutate(type = as.character(type)) %>%
pivot_wider(names_from = type, values_from = total_bonds, values_fill = 0L) %>%
mutate(
grand_total = Monomer + Dimer + Tetramer,
# Calculate fractions (default to 0 if grand_total is 0 to avoid NaN)
Monomer_frac = if_else(grand_total > 0, Monomer / grand_total, 0),
Dimer_frac   = if_else(grand_total > 0, Dimer / grand_total, 0),
Tetramer_frac = if_else(grand_total > 0, Tetramer / grand_total, 0)
) %>%
select(position, ends_with("_frac"))
# 2. Pivot back to long format for ggplot faceting
bonds_fraction_long <- bonds_wide %>%
pivot_longer(
cols = ends_with("_frac"),
names_to = "bond_type",
names_pattern = "(.*)_frac",
values_to = "fraction"
)
# 3. Generate full residue map (1:378) and merge fractions
plot_fraction_data <- tibble(position = 1:378) %>%
mutate(lof_status = if_else(position %in% lof_data$residue, "LOF", "Non-LOF")) %>%
left_join(bonds_fraction_long, by = "position") %>%
# FIX: Use dplyr::coalesce instead of tibble::coalesce
mutate(
bond_type = dplyr::coalesce(bond_type, "Monomer"),
fraction = dplyr::coalesce(fraction, 0)
)
# 4. Create the fraction comparison plot
ggplot(plot_fraction_data, aes(x = lof_status, y = fraction, fill = lof_status)) +
geom_violin(alpha = 0.5, trim = TRUE, scale = "width", outlier.shape = NA) +
geom_jitter(width = 0.2, alpha = 0.4, size = 1) +
facet_wrap(~bond_type, scales = "free_y") +
stat_compare_means(
comparisons = list(c("LOF", "Non-LOF")),
method = "wilcox.test",
method.args = list(alternative = "two.sided"),
label = "p.signif"
) +
labs(
title = "Fraction of Bond Types per Residue by LOF Status",
subtitle = "Fraction = # Type / Total Bonds for that Residue",
x = "Mutation Status",
y = "Fraction of Total Bonds"
) +
theme_minimal() +
theme(legend.position = "none")
