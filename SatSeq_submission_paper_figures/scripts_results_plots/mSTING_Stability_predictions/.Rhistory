library(ggplot2)
library(patchwork)
# Define a quick reusable function to save space
make_hist <- function(data_vec, title_text) {
ggplot(data.frame(x = data_vec), aes(x = x)) +
geom_histogram(bins = 100, fill = "gray", color = "black") +
labs(x = "STING Stability", y = "Frequency", title = title_text) +
theme_minimal()
}
# Generate the 4 plots
p1 <- make_hist(facs_fitness$mean_fit_true, "FACS Fitness")
p2 <- make_hist(p_ThermoMPNN$data$mean_fit, "ThermoMPNN")
p3 <- make_hist(p_ProteinMPNN$data$mean_fit, "ProteinMPNN")
p4 <- make_hist(p_DeepDDG$data$mean_fit, "DeepDDG")
# Now the division operator works perfectly!
p1 / p2 / p3 / p4
