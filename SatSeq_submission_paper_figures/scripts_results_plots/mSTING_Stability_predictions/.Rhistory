panel.grid.major.x = element_blank(),
panel.grid.minor.x = element_blank()
) +
labs(
x = "Amino Acid Position (REF = mSTING_WT)",
y = "Cell\ncounts" # Multiline left axis title
)
# 10. Combine layouts using patchwork and declare strict relative row scales
# Custom heights array: 4 parts given to pathway panels, 1 part given to the barplot
p <- p1 / p2 + plot_layout(heights = c(4, 1))
ggsave(plot=p, 'hotspot_per_position.pdf',
width=15, height=5)
library(dplyr)
library(tidyr)
library(stringr)
library(ggplot2)
library(patchwork) # Required to stack the main plots and the barplot flawlessly
# 1. Load the dataset
df <- read.csv("hotspot_module_scores_tumor_4T1.csv", check.names = FALSE)
# Fix for empty/NA column names
names(df)[names(df) == "" | is.na(names(df))] <- paste0("v", seq_along(names(df)[names(df) == "" | is.na(names(df))]))
# 2. Pivot the dataset into long format
df_long <- df %>%
pivot_longer(
cols = c("1", "2", "3"),
names_to = "pathway_id",
values_to = "score"
) %>%
mutate(
pathway = case_when(
pathway_id == "1" ~ "Proliferation",
pathway_id == "2" ~ "IFN",
pathway_id == "3" ~ "NFkB"
),
pathway = factor(pathway, levels = c("Proliferation", "IFN", "NFkB"))
)
# 3. Process WT data (Assigned to position 0)
df_wt <- df_long %>%
filter(str_detect(variant_substitution, "mSTING_WT")) %>%
mutate(position = 0)
# Extract precise baseline mean scalars per pathway
mean_prolif <- mean(df_wt$score[df_wt$pathway == "Proliferation"], na.rm = TRUE)
mean_ifn    <- mean(df_wt$score[df_wt$pathway == "IFN"], na.rm = TRUE)
mean_nfkb   <- mean(df_wt$score[df_wt$pathway == "NFkB"], na.rm = TRUE)
# 4. Process Variant data (Positions 1:378)
df_variants <- df_long %>%
filter(!str_detect(variant_substitution, "mSTING_WT")) %>%
mutate(position = as.numeric(str_extract(variant_substitution, "\\d+"))) %>%
filter(!is.na(position) & position >= 1 & position <= 378)
# 5. Compute Wilcoxon test at each position vs WT reference
significance_data <- df_variants %>%
group_by(pathway, position) %>%
summarize(
max_score = max(score, na.rm = TRUE), # Find violin tip for the line segment
p_value = tryCatch({
current_scores <- score
wt_reference <- df_wt$score[df_wt$pathway == first(pathway)]
wilcox.test(current_scores, wt_reference)$p.value
}, error = function(e) NA),
.groups = "drop"
) %>%
mutate(
stars = ifelse(!is.na(p_value) & p_value < 0.01, "*", ""),
position_factor = factor(position, levels = c(0, 1:378))
) %>%
filter(stars == "*")
# 6. Combine WT and Variants into a single unified dataframe for plotting
df_plot <- bind_rows(df_wt, df_variants) %>%
mutate(
position_factor = factor(position, levels = c(0, 1:378))
)
# Compute global maximums for a uniform star line height within each facet grid
star_heights <- df_plot %>%
group_by(pathway) %>%
summarize(global_max = max(score, na.rm = TRUE), .groups = "drop") %>%
mutate(constant_y = global_max + (abs(global_max) * 0.12)) # Added safety clearance
# Map constant star heights and segment limits directly to the significance table
significance_data <- significance_data %>%
left_join(star_heights, by = "pathway")
# Map the fixed pathway mean values as a direct conditional column in the plot frame
df_plot <- df_plot %>%
mutate(
wt_mean_line = case_when(
pathway == "Proliferation" ~ mean_prolif,
pathway == "IFN" ~ mean_ifn,
pathway == "NFkB" ~ mean_nfkb
)
# 7. Define color palette
pathway_colors <- c(
"Proliferation" = "black",
"IFN" = "#e3312a",
"NFkB" = "#7ac943"
)
# 8. Build Figure 1: Main Pathway Grid
p1 <- ggplot(df_plot, aes(x = position_factor, y = score, fill = pathway)) +
# Thin violins in the background layer
geom_violin(
linewidth = 0.1,
alpha = 0.8,
scale = "width"
) +
# (1) Solid black horizontal WT mean baseline brought to the front
geom_line(
aes(y = wt_mean_line, group = pathway),
color = "black",
linetype = "solid",
linewidth = 0.5
) +
# (2) Vertical thin line segments connecting violin tips to the stars
geom_segment(
data = significance_data,
aes(x = position_factor, xend = position_factor, y = max_score, yend = constant_y),
inherit.aes = FALSE,
color = "black",
linewidth = 0.2
) +
# Stars annotation layer placed on top of lines
geom_text(
data = significance_data,
aes(x = position_factor, y = constant_y, label = stars),
inherit.aes = FALSE,
color = "black",
size = 4,
vjust = 0.3
) +
facet_grid(pathway ~ ., scales = "fixed") +
scale_fill_manual(values = pathway_colors) +
scale_x_discrete(drop = FALSE, breaks = NULL) + # Hide labels; bottom plot handles them
theme_cowplot(font_size = 12) +
theme(
strip.text.y = element_text(angle = 0, hjust = 0),
legend.position = "none",
axis.text.x = element_blank(),
axis.title.x = element_blank(),
panel.grid.major.x = element_blank(),
panel.grid.minor.x = element_blank()
) +
labs(
y = "Module Score",
)
# 9. (3) Build Figure 2: Bottom Gray Barplot for Cell Counts (Excluding REF)
df_counts <- df_plot %>%
# Exclude REF (position 0)
filter(position != 0) %>%
# Count unique entries per position (grouped by pathway to match factor scale context)
group_by(position_factor, pathway) %>%
summarize(cell_count = n(), .groups = "drop") %>%
# Use just one pathway configuration to get absolute sample distribution
filter(pathway == "Proliferation")
p2 <- ggplot(df_counts, aes(x = position_factor, y = cell_count)) +
geom_bar(stat = "identity", fill = "darkgray", width = 0.8) +
scale_x_discrete(
drop = FALSE,
breaks = c(0, seq(20, 378, by = 20)),
labels = function(x) ifelse(x == "0", "REF", x)
) +
theme_minimal(base_size = 14) +
theme(
# Create an empty, invisible right strip so its layout bounds match p1 perfectly
strip.text.y = element_text(color = "white", angle = 0, hjust = 0),
strip.background = element_rect(fill = "white", color = NA),
axis.text.x = element_text(angle = 90, vjust = 0.5, hjust = 1, size = 8),
panel.grid.major.x = element_blank(),
panel.grid.minor.x = element_blank()
) +
labs(
x = "Amino Acid Position (REF = mSTING_WT)",
y = "Cell\ncounts" # Multiline left axis title
)
# 10. Combine layouts using patchwork and declare strict relative row scales
# Custom heights array: 4 parts given to pathway panels, 1 part given to the barplot
p <- p1 / p2 + plot_layout(heights = c(4, 1))
ggsave(plot=p, 'hotspot_per_position.pdf',
width=15, height=5)
